//@version=5
indicator("Seasonal Tendencies & Correlations", overlay=false, max_labels_count=500)

// ───────────────────── Inputs ─────────────────────
yearsBack      = input.int(15,  "Years of history to average", minval=3, maxval=40)
minBarsMonth   = input.int(10,  "Minimum bars in month to include", minval=5, maxval=100)
showTable      = input.bool(true, "Show seasonal table")
highlightMonth = input.bool(true, "Highlight current month")
corrLen        = input.int(60,  "Days used for correlation", minval=5, maxval=250)
corrMethod     = input.string("Pearson", "Correlation method", options=["Pearson","Spearman"])

// ───────────────────── Helpers ─────────────────────
var monthNames = array.from("Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec")

f_monthly_returns() =>
    var float[] rets = array.new_float()
    var int[]   mths = array.new_int()
    var int[]   yrs  = array.new_int()
    var float   startClose = na
    var int     lastMonth = na
    var int     lastYear  = na
    for i = bar_index to 0
        idx = bar_index - i
        thisMonth = month[idx]
        thisYear  = year[idx]
        if na(startClose)
            startClose := close[idx]
            lastMonth := thisMonth
            lastYear  := thisYear
        // Detect month change
        if thisMonth != lastMonth or thisYear != lastYear
            ret = (close[idx+1] - startClose) / startClose
            array.push(rets, ret)
            array.push(mths, lastMonth)
            array.push(yrs,  lastYear)
            startClose := close[idx]
            lastMonth  := thisMonth
            lastYear   := thisYear
        // Handle first bar
        if idx == 0
            ret = (close[idx] - startClose) / startClose
            array.push(rets, ret)
            array.push(mths, thisMonth)
            array.push(yrs,  thisYear)
    [rets, mths, yrs]

// ───────────────────── Compute monthly stats ─────────────────────
[rets, mths, yrs] = f_monthly_returns()
curMonth = month
curYear  = year

f_avg_month(monthNum, maxYears) =>
    sum = 0.0
    n   = 0
    for i = 0 to array.size(rets) - 1
        if array.get(mths, i) == monthNum and (curYear - array.get(yrs, i) <= maxYears) and (curYear - array.get(yrs, i) >= 1)
            sum += array.get(rets, i)
            n   += 1
    n > 0 ? sum / n : na

f_month_ret(yearVal, monthVal) =>
    for i = 0 to array.size(rets) - 1
        if array.get(yrs, i) == yearVal and array.get(mths, i) == monthVal
            array.get(rets, i)
    na

// Current month-to-date return
curMonthStart = ta.valuewhen(month != month[1] or year != year[1], close[1], 0)
curMonthRet   = na(curMonthStart) ? na : (close - curMonthStart) / curMonthStart

// Last year's same-month return
lastYearRet = f_month_ret(curYear - 1, curMonth)

// Correlation between current month daily returns vs same month last year
f_daily_returns_in_month(targetYear, targetMonth) =>
    var float[] d = array.new_float()
    for i = 0 to corrLen - 1
        if i < bar_index
            if year[i] == targetYear and month[i] == targetMonth
                array.push(d, close[i] / close[i+1] - 1)
    d

curDaily = f_daily_returns_in_month(curYear, curMonth)
prevDaily = f_daily_returns_in_month(curYear - 1, curMonth)

f_corr(a1, a2) =>
    sz = math.min(array.size(a1), array.size(a2))
    if sz < 3
        na
    else
        // Align to same length
        float[] x = array.new_float()
        float[] y = array.new_float()
        for i = 0 to sz - 1
            array.push(x, array.get(a1, i))
            array.push(y, array.get(a2, i))
        corrMethod == "Spearman" ? ta.spearman(x, y) : ta.correlation(x, y)

monthCorr = f_corr(curDaily, prevDaily)

// ───────────────────── Table Rendering ─────────────────────
if showTable
    var table t = table.new(position.top_right, 5, 13, border_width=1)
    // Headers
    table.cell(t, 0, 0, "Month",    text_color=color.white, bgcolor=color.rgb(30,30,30))
    table.cell(t, 1, 0, "Avg "+str.tostring(yearsBack)+"y", text_color=color.white, bgcolor=color.rgb(30,30,30))
    table.cell(t, 2, 0, "Last Year", text_color=color.white, bgcolor=color.rgb(30,30,30))
    table.cell(t, 3, 0, "This Year", text_color=color.white, bgcolor=color.rgb(30,30,30))
    table.cell(t, 4, 0, "Corr TY vs LY", text_color=color.white, bgcolor=color.rgb(30,30,30))
    // Rows
    for r = 0 to 11
        mName = array.get(monthNames, r)
        avg   = f_avg_month(r+1, yearsBack)
        ly    = f_month_ret(curYear - 1, r+1)
        ty    = curMonth == r+1 ? curMonthRet : na
        corr  = curMonth == r+1 ? monthCorr : na
        isCur = highlightMonth and (curMonth == r+1)
        bg    = isCur ? color.rgb(45,70,120) : color.new(color.black, 0)
        toPct(x) => na(x) ? "—" : str.tostring(x*100, format.mintick)+"%"
        table.cell(t, 0, r+1, mName, text_color=color.white, bgcolor=bg)
        table.cell(t, 1, r+1, toPct(avg), text_color=color.white, bgcolor=bg)
        table.cell(t, 2, r+1, toPct(ly),  text_color=color.white, bgcolor=bg)
        table.cell(t, 3, r+1, toPct(ty),  text_color=color.white, bgcolor=bg)
        table.cell(t, 4, r+1, na(corr) ? "—" : str.tostring(corr, format.mintick), text_color=color.white, bgcolor=bg)

// Plot current-month MTD return and last year same-month return for quick reference
plot(curMonthRet, "MTD Return", color=color.teal, style=plot.style_columns, display=display.none)
plot(lastYearRet, "Last Year Return", color=color.orange, style=plot.style_line, display=display.none)
